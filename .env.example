# paper-boxing: settings for docker-compose.yml. Copy to .env beside it and edit;
# in Portainer, enter the same names as the stack's environment variables.

# The address at which people and links reach the site server (never changes afterwards).
PAPER_BOXING_PUBLIC_SITES_URL=http://CHANGE-ME:35841

# The first account, created when no account exists yet.
PAPER_BOXING_ADMIN_USERNAME=admin
PAPER_BOXING_ADMIN_PASSWORD=CHANGE-ME

# A long random string that signs the UI's session cookie, for example `openssl rand -hex 32`.
PAPER_BOXING_STORAGE_SECRET=CHANGE-ME

# Host values agents connect to the MCP server with; a request with another Host gets 421.
PAPER_BOXING_MCP_ALLOWED_HOSTS=CHANGE-ME:35842,localhost:*,127.0.0.1:*

# Optional, with these defaults.
# PAPER_BOXING_MAX_UPLOAD_MB=200
# PAPER_BOXING_SESSION_DAYS=14
# PAPER_BOXING_MCP_MAX_FILE_MB=8
# PAPER_BOXING_MCP_ALLOWED_ORIGINS=
